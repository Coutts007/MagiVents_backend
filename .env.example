# Copy to .env and adjust. All values are optional for local development.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Must be the same OAuth client ID as VITE_GOOGLE_CLIENT_ID in the frontend .env
GOOGLE_OAUTH_CLIENT_ID=

# Set these to use Postgres / Redis instead of SQLite / in-memory cache
# POSTGRES_HOST=localhost
# POSTGRES_DB=magivents_db
# POSTGRES_USER=magivents_user
# POSTGRES_PASSWORD=magivents_password
# REDIS_URL=redis://localhost:6379/1

# M-Pesa Paybill (or Till) shown to attendees who pay manually. The default 000000 is a placeholder:
# set your own business number before taking real payments.
MPESA_PAYBILL_NUMBER=000000
MPESA_ACCOUNT_NAME=MagiVents

# Rate limit for checking promo codes at checkout (per IP)
PROMO_VALIDATE_RATE=30/minute

# Optional: SQLite file to use instead of db.sqlite3 (ignored when POSTGRES_HOST is set)
# SQLITE_PATH=/path/to/other.sqlite3

# Public address of the frontend. Ticket QR codes and email links point here.
FRONTEND_URL=http://localhost:3000

# Email. The console backend (default) prints emails to the server log. For real email use
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend and fill in the SMTP settings.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=MagiVents <magiventskenya@gmail.com>
MAGIVENTS_CONTACT_EMAIL=magiventskenya@gmail.com
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True

# Rate limits (per IP) for guest ticket lookup and confirmation email resends
TICKET_LOOKUP_RATE=10/hour
TICKET_RESEND_RATE=5/hour

# --- Payments ---------------------------------------------------------------------------------
# simulated (default): a fake gateway runs the real pending -> confirmed lifecycle; no credentials,
# no money. live: Safaricom Daraja for M-Pesa and Paystack for cards.
PAYMENTS_MODE=simulated
# Minutes a pending booking holds its tickets
PAYMENT_HOLD_MINUTES=10
# Seconds the simulated gateway takes to complete a payment (0 = immediately)
PAYMENTS_SIMULATED_DELAY_SECONDS=6
# Rate limit (per IP) for starting payment attempts on an existing booking
PAYMENT_ATTEMPT_RATE=20/hour

# Public HTTPS address of this API; Daraja and Paystack send callbacks here
PUBLIC_API_URL=http://localhost:8000
# Long random string used in the Daraja callback paths (Daraja does not sign callbacks).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
PAYMENT_CALLBACK_SECRET=
# Only accept Daraja callbacks from these IPs (comma separated). Leave empty in sandbox; in production use
# Safaricom's published list (payments/providers/daraja.py SAFARICOM_CALLBACK_IPS).
DARAJA_ALLOWED_IPS=
# True when a reverse proxy (nginx, a load balancer) sets X-Forwarded-For
BEHIND_PROXY=False

# Safaricom Daraja (M-Pesa). Sandbox app keys come from developer.safaricom.co.ke.
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# STK Push: sandbox shortcode is 174379; the sandbox passkey is on the Daraja test credentials page
MPESA_STK_SHORTCODE=
MPESA_PASSKEY=
# CustomerPayBillOnline (Paybill) or CustomerBuyGoodsOnline (Till: also set MPESA_STK_PARTY_B to the till number)
MPESA_STK_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_STK_PARTY_B=
# Paybill for manual payments (sandbox C2B shortcode is 600984). Register its callbacks once with:
#   python manage.py register_c2b_urls
MPESA_C2B_SHORTCODE=

# Paystack (cards): secret key from the Paystack dashboard (sk_test_... until going live).
# Webhook URL to set in the dashboard: <PUBLIC_API_URL>/api/payments/hooks/paystack/
PAYSTACK_SECRET_KEY=
