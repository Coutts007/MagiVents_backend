# /magivents/.env.example

# Database Configuration (Matches docker-compose.yml defaults)
DB_NAME=magivents_db
DB_USER=admin
DB_PASSWORD=your_local_db_password_here
DB_HOST=db
DB_PORT=5432

# Django Settings
# Generate a new secret key for local development
DJANGO_SECRET_KEY=replace_this_with_a_long_random_string
DEBUG=True